generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("USER")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  managedPromotions Promotion[]

  @@map("users")
}

model Campus {
  id        String   @id @default(uuid())
  name      String
  city      String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  promotions Promotion[]
  students   Student[]

  @@map("campuses")
}

model Promotion {
  id             String    @id @default(uuid())
  name           String
  campusId       String    @map("campus_id")
  managerUserId  String    @map("manager_user_id")
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  campus  Campus @relation(fields: [campusId], references: [id])
  manager User   @relation(fields: [managerUserId], references: [id])
  students Student[]

  @@map("promotions")
}

model Student {
  id           String   @id @default(uuid())
  firstname    String
  lastname     String
  phone        String?
  email        String?  @unique
  discordLogin String?  @map("discord_login")
  city         String?

  campusId     String   @map("campus_id")
  promotionId  String   @map("promotion_id")

  isAlerte                   Boolean @default(false) @map("is_alerte")
  isAbandon                  Boolean @default(false) @map("is_abandon")
  isHyppoRefused             Boolean @default(false) @map("is_hyppo_refused")
  isHyppoAccepted            Boolean @default(false) @map("is_hyppo_accepted")
  isFinancementOk            Boolean @default(false) @map("is_financement_ok")
  isAdminStatusOk            Boolean @default(false) @map("is_admin_status_ok")
  isMaterialSetupOk          Boolean @default(false) @map("is_material_setup_ok")
  isEmployabilityInitialised Boolean @default(false) @map("is_employability_initialised")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campus    Campus    @relation(fields: [campusId], references: [id])
  promotion Promotion @relation(fields: [promotionId], references: [id])

  studentSkills StudentSkill[]

  @@map("students")
}

model Skill {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  studentSkills StudentSkill[]

  @@map("skills")
}

model StudentSkill {
  id        String   @id @default(uuid())
  studentId String   @map("student_id")
  skillId   String   @map("skill_id")
  createdAt DateTime @default(now()) @map("created_at")

  student Student @relation(fields: [studentId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([studentId, skillId])
  @@map("student_skills")
}


